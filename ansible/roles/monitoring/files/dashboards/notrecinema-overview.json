          "expr": "topk(8, histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{job=\"notrecinema-api\"}[5m]))))",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
